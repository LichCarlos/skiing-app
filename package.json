{
  "name": "@linji/mobile",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "expo-doctor": "1.21.5",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "~6.0.3",
    "vitest": "4.1.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint --type-aware app/ src/ components/ scripts/ app.config.ts",
    "release:check": "node --experimental-strip-types scripts/verify-native-release.ts",
    "eas-build-post-install": "pnpm release:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:settings-http": "vitest run --config vitest.config.http.ts",
    "test:profile-http": "vitest run --config vitest.config.profile-http.ts",
    "test:resort-list-http": "vitest run --config vitest.config.resort-list-http.mts",
    "test:ai-http": "vitest run --config vitest.config.ai-http.mts",
    "test:community-http": "vitest run --config vitest.config.community-http.mts",
    "test:composer-http": "vitest run --config vitest.config.composer-http.mts",
    "test:knowledge-list-http": "vitest run --config vitest.config.knowledge-list-http.mts",
    "test:expo-web-http": "vitest run --config vitest.config.expo-web-http.mts",
    "openapi:generate": "openapi-typescript contracts/openapi.json -o src/platform/api/openapi.ts",
    "openapi:verify": "node scripts/verify-openapi.mjs && openapi-typescript --check contracts/openapi.json -o src/platform/api/openapi.ts",
    "source:export": "node --experimental-strip-types scripts/export-source.ts",
    "test:source-export": "node --experimental-strip-types --test --test-concurrency=1 scripts/export-source.node-test.ts",
    "artifact:seal": "node --experimental-strip-types scripts/export-artifact.ts seal",
    "artifact:verify": "node --experimental-strip-types scripts/export-artifact.ts verify",
    "test:export-artifact": "node --experimental-strip-types --test --test-concurrency=1 scripts/export-artifact.node-test.ts",
    "check": "pnpm openapi:verify && pnpm lint && pnpm typecheck && pnpm test && pnpm test:source-export && pnpm test:export-artifact && expo-doctor",
    "source:verify": "node --experimental-strip-types scripts/export-source.ts --verify"
  },
  "private": true
}
