EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Expo Web: 同站、不同Origin的API；将UI Origin加入后端WEB_ORIGINS。
# HTTPS/localhost安全上下文、Web Locks、站点存储必需；不可混用localhost和127.0.0.1。
# EAS preview/production: set these in the selected EAS environment (plain text).
# Values are application identity, not credentials. Keep actual signing files outside Git.
# LINJI_APP_ENV=production
# LINJI_ANDROID_PACKAGE=<your registered Android package>
# LINJI_IOS_BUNDLE_IDENTIFIER=<your registered iOS bundle identifier>
# LINJI_EAS_PROJECT_ID=<your existing EAS project UUID>
# LINJI_EXPO_OWNER=<your Expo account or organization>
# EXPO_PUBLIC_API_BASE_URL=https://<your-api-host>/api/v1
